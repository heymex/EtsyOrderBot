# Etsy app credentials (etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Must match a callback URL registered on your Etsy app exactly (https only).
# For local dev, use a tunnel (ngrok, Cloudflare Tunnel, etc.) — Etsy does not accept http://localhost.
# With docker-compose.yml + Traefik, use the same host as ORDERBOT_DOMAIN, e.g.:
# ETSY_REDIRECT_URI=https://orderbot.example.com/callback
ETSY_REDIRECT_URI=https://your-subdomain.example.com/callback

# Used to encrypt the session cookie (OAuth state + PKCE verifier during login).
SESSION_SECRET=change-this-to-a-long-random-string

# Optional (default 3000)
# PORT=3000

# Behind Traefik or another reverse proxy (reads X-Forwarded-* for req.ip / req.secure).
# docker-compose.yml sets TRUST_PROXY=1 by default.
# TRUST_PROXY=1

# --- docker-compose.yml + Traefik (hostname only, no https://)
# ORDERBOT_DOMAIN=orderbot.example.com
# Optional: image tag (default latest), in-container port (default 3000), TLS resolver name (default cf)
# ORDERBOT_IMAGE_TAG=latest
# ORDERBOT_PORT=3000
# ORDERBOT_CERT_RESOLVER=cf
